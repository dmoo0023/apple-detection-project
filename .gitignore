# Python
__pycache__/
*.pyc
.venv/

# Raw data is never copied into the repo; see configs/paths.yaml.
data/raw/

# Bulk derived imagery is excluded, but data/derived/overlays/ (a handful of
# small sample overlays per stage, used to explain the pipeline) is kept -
# see the allow rule for it near the bottom of this file.
data/derived/*.png
data/derived/**/*.jpg

# YOLO training datasets: copies of raw images (+ Ultralytics' *.cache files),
# regenerated on demand by scripts/prepare_yolo_dataset.py /
# prepare_yolo_seg_dataset.py -- never committed (rule 1's spirit).
data/derived/yolo_dataset/
data/derived/yolo_dataset_seg/
*.cache

# Model weights
*.pt
*.pth

# Large run/result artefacts (tables, configs and small plots are kept --
# results.csv, args.yaml, the *.png metric curves; only the bulky per-batch
# *.jpg sample mosaics Ultralytics writes every run are excluded, since
# Stage 8 will produce many runs and these add up fast)
runs/**/weights/
runs/**/*.pt
runs/**/*.pth
runs/**/*.jpg

# Keep small tracked result tables / manifests / sample overlays despite the patterns above
!data/derived/manifest.csv
!data/derived/apples_2d.csv
!data/derived/checksums.txt
!data/derived/overlays/
!data/derived/overlays/*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
