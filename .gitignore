# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Raw data is never copied into the repo; see configs/paths.yaml.
data/raw/

# Generated pipeline data: regenerated by the Stage 1-2 scripts. Only the
# small files the code needs as inputs are tracked (allow rules below).
data/derived/*
!data/derived/manifest.csv
!data/derived/apples_2d.csv
!data/derived/checksums.txt
*.cache

# Model weights
*.pt
*.pth

# Training runs: everything Ultralytics writes is regenerated by
# scripts/train_yolo.py. Only the run log is tracked.
runs/*
!runs/experiments.csv

# Pipeline outputs (tables, figures, apples_3d.csv) are regenerated by the
# scripts. Only the tuned classical-detector config, which the Stage 9
# script reads as an input, is tracked.
results/*
!results/baseline_colour_v1_config.json

# Local working notes and report material (kept locally, not part of the repo)
report/
EXPERIMENTS.md
docs/*.md
scripts/collect_report_assets.py
scripts/optimisation_figures.py

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
